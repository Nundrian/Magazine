    "function_export_sha256": "f3f8a1c6910e0e2905316b28820b194e94253cb86d6d4c90947e9b6ce88830d0"
  },
  "include": [
    ".gitignore",
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "pyproject.toml",
    "requirements-test.txt",
    "docs/*.md",
    "docs/images/**/*",
    "docs/screenshots/**/*",
    "examples/simple/**/*",
    "magazine/**/*.py",
    "tests/**/*.py",
    "integrations/open_webui/function/README.md",
    "integrations/open_webui/function/magazine_ef.py",
    "integrations/open_webui/function/magazine-function.json",
    "integrations/open_webui/function/tests/**/*",
    "release/embedded-core-manifest.json",
    "scripts/*.py",
    "release/function-only-manifest.json"
  ],
  "exclude": [
    ".git/**",
    ".build/**",
    ".release-venv/**",
    ".uv-cache/**",
    ".pytest_cache/**",
    "**/__pycache__/**",
    "**/*.pyc",
    "dist/**",
    "build/**",
    "*.egg-info/**",
    ".env",
    ".env.*",
    "**/*.pem",
    "**/*.key",
    "**/deploy.py",
    "fm1-running-state-acceptance-evidence/**",
    "evidence/**",
    "deployment-backups/**",
    "histories/**",
    "private-backups/**",
    "review_*.py",
    "record_checks.py",
    "prepare_candidate.py",
    "refresh_manifests.py",
    "finalize_candidate.py"
  ],
  "excluded_categories": [
    "credentials and local environment files",
    "deployment backups and live exports",
    "saved chat and workflow histories",
    "development caches, virtual environments and build trees",
    "FM-1 historical acceptance evidence",
    "destructive deployment scripts, including deploy.py"
  ],
  "required": [
    "docs/SECURITY.md",
    "docs/FUNCTION_INSTALL.md",
    "release/function-only-manifest.json"
  ],
  "distribution": "Native Function and Magazine source only; no Open WebUI or third-party binary/source distribution",
  "distribution_kind": "function-only"
}
